# ============================================
# Smart City Dashboard — Backend Environment
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit the .env file to Git!

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/smartcity?retryWrites=true&w=majority
# Optional: Node-only resolvers when a local DNS proxy rejects MongoDB SRV queries
DNS_SERVERS=1.1.1.1,8.8.8.8

# JWT Secrets (use strong random strings)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# External APIs
TOMTOM_API_KEY=your_tomtom_api_key
GOONG_API_KEY=your_goong_api_key
OPENWEATHER_API_KEY=your_openweather_api_key

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# Email (SMTP - Gmail)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# App mobile đăng nhập Google bằng ID token có `aud` = GOOGLE_CLIENT_ID (client web,
# app dùng làm serverClientId). Client Android chỉ cần TẠO trong cùng project Google
# Cloud (package + SHA-1), không cần khai ở đây. Thêm client ID khác (vd. iOS) nếu
# token của nó mang `aud` riêng, phân tách bằng dấu phẩy:
# GOOGLE_MOBILE_CLIENT_IDS=

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000

# Priority scoring jobs (optional)
PRIORITY_CRON_SCHEDULE=*/15 * * * *
PRIORITY_BATCH_LIMIT=500
PRIORITY_BATCH_CONCURRENCY=5
PRIORITY_BACKFILL_BATCH_SIZE=200

# Duplicate detection with pretrained embeddings (optional; lexical fallback if disabled/failing)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_MS=3500
EMBEDDING_MAX_ATTEMPTS=2
EMBEDDING_CRON_SCHEDULE=*/5 * * * *
EMBEDDING_BATCH_LIMIT=100
EMBEDDING_BATCH_CONCURRENCY=3
EMBEDDING_BACKFILL_BATCH_SIZE=50

# App mobile (task 0.8) — bản thấp nhất còn được hỗ trợ / bản mới nhất trên store.
# Nâng MOBILE_MIN_SUPPORTED_VERSION là buộc mọi máy chạy bản cũ hơn phải cập nhật.
MOBILE_MIN_SUPPORTED_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
ANDROID_STORE_URL=
IOS_STORE_URL=

# Seed demo cho app — CHỈ MongoDB cục bộ (script xoá sạch database đích)
# APP_DEMO_MONGODB_URI=mongodb://127.0.0.1:27017/smartcity_app_demo
